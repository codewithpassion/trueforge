{
  "name": "@truefoundry/trueforge-computer",
  "version": "0.1.0",
  "private": true,
  "description": "Go daemon that connects a machine you own to TrueForge, so an agent's commands run there.",
  "license": "MIT",
  "scripts": {
    "build": "bash scripts/build-all.sh",
    "build:local": "bash scripts/go.sh go build -trimpath -o bin/trueforge-computer ./cmd/trueforge-computer",
    "check": "pnpm run vet && pnpm run fmt:check && pnpm run test",
    "docker:build": "docker build -t trueforge-computer:local .",
    "docker:build:desktop": "docker build -f Dockerfile.desktop -t trueforge-computer-desktop:local .",
    "fmt": "bash scripts/go.sh gofmt -w .",
    "fmt:check": "bash scripts/fmt-check.sh",
    "test": "bash scripts/go.sh go test ./...",
    "test:race": "bash scripts/test-race.sh",
    "test:desktop-image": "bash scripts/test-desktop-image.sh",
    "tidy": "bash scripts/go.sh go mod tidy",
    "vet": "bash scripts/go.sh go vet ./..."
  }
}
