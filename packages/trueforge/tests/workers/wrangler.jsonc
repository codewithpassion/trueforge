{
  "name": "trueforge-workers-tests",
  "main": "../../src/workers/index.ts",
  // The newest date the pool's bundled workerd supports; the deployed Worker may use a later one.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trueforge-workers-tests",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations/d1",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "trueforge-workers-tests-files" }],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_DO", "class_name": "SessionDO" },
      { "name": "SCHEDULER_DO", "class_name": "SchedulerDO" },
      { "name": "COMPUTER_DO", "class_name": "ComputerDO" },
      { "name": "REMOTE_COMPUTER_DO", "class_name": "RemoteComputerDO" },
      { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["SchedulerDO"] },
    { "tag": "v3", "new_sqlite_classes": ["ComputerDO"] },
    { "tag": "v4", "new_sqlite_classes": ["RemoteComputerDO"] },
    { "tag": "v5", "new_sqlite_classes": ["RateLimitDO"] },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "TRUEFORGE_RUNTIME": "workers",
    "OIDC_ISSUER_URL": "https://issuer.test/",
    "OIDC_CLIENT_ID": "trueforge-workers-tests",
    "OIDC_CLIENT_SECRET": "workers-tests-secret",
    "PUBLIC_BASE_URL": "https://trueforge.test",
    "LOG_LEVEL": "warn",
    // As deployed: the built-in sandbox is available, and a tenant still has to enable it.
    "TRUEFORGE_SANDBOX_BACKEND": "cloudflare-computer",
  },
}
