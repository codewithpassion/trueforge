// Cloudflare Workers deploy config. Per deployment, set d1_databases[].database_id and the vars below
// (docs/deploy/cloudflare.mdx); run `pnpm workers:types` after changing vars or bindings.
{
  "name": "trueforge",
  "account_id": "a12823016aa16d0a8dd2678b258bd751",
  "main": "src/workers/index.ts",
  "routes": [{ "pattern": "trueforge.rockyshoreslabs.io", "custom_domain": true }],
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trueforge-rockyshoreslabs",
      "database_id": "e6f6c044-e2fa-41ff-ba9f-ec45d6a5bbf5",
      "migrations_dir": "migrations/d1",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_DO", "class_name": "SessionDO" },
      { "name": "SCHEDULER_DO", "class_name": "SchedulerDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["SchedulerDO"] },
  ],
  // Only re-arms the scheduler's alarm; dispatch itself runs from that alarm.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Built by `pnpm build:workers-assets`. Files are served without running the Worker; misses reach the
  // Worker, which answers navigations with the UI shell and everything else with 404.
  "assets": {
    "directory": "./dist-workers-assets",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Must cover SERVER_PATH_PREFIXES in src/frontendShell.ts (checked by a unit test).
    "run_worker_first": ["/api", "/api/*", "/healthz", "/healthz/*"],
  },
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  // Deployment values for trueforge.rockyshoreslabs.io. PUBLIC_BASE_URL must be an origin with no path.
  // Secrets such as OIDC_CLIENT_SECRET go through `wrangler secret put`, or packages/trueforge/.env
  // locally. Keep *_CATALOG_PATH unset.
  "vars": {
    "TRUEFORGE_RUNTIME": "workers",
    "OIDC_ISSUER_URL": "https://inviting-ray-7546.clerk.accounts.dev",
    "OIDC_CLIENT_ID": "w7xxkUI0NdWF8GP8",
    "PUBLIC_BASE_URL": "https://trueforge.rockyshoreslabs.io",
    // Clerk ID tokens carry no groups claim, so the admin is matched by email.
    "OIDC_USER_ROLE_CLAIM": "email",
    "OIDC_ADMIN_ROLE_VALUE": "dominik.fretz@harbouredgeintelligence.com",
    "OIDC_ALLOWED_EMAILS": "dominik.fretz@harbouredgeintelligence.com",
  },
}
